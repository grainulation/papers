    "spans": [
     {
      "end": 251,
      "start": 0,
      "text": "Nicolaus Germanus\nNicolaus Germanus was a German cartographer who published an edition of Jacopo d'Angelo 's Latin translation of Ptolemy 's Geography . He also created two globes depicting earth and sky in 1477 , predating Martin Behaim 's Erdapfel ."
     }
    ],
    "status": "ok"
   },
