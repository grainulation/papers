    "raw_output_sha256": "b462815b026d368c87de85bef246111530f850866b93c37693f07fdffec80004",
    "score_q": 96,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
      "k1_x1000": 1200,
      "overlap_chars": 200
