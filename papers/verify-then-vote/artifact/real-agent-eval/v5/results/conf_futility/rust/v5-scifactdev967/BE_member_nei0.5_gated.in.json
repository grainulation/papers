     "version": "1"
    },
    "spans": [
     {
      "end": 590,
      "start": 0,
      "text": "D3 phosphoinositides and outside-in integrin signaling by glycoprotein IIb-IIIa mediate platelet actin assembly and filopodial extension induced by phorbol 12-myristate 13-acetate.\nPhosphatidylinositol 3,4-bisphosphate inhibits actin filament severing and capping by human gelsolin in vitro. The findings implicate D3 polyphosphoinositides and integrin signaling in PMA-mediated platelet stimulation and implicate D3 containing phosphoinositides generated in response to protein kinase C activation and GPIIb-IIIa signaling as late-acting intermediates leading to filopodial actin assembly."
     }
    ],
    "status": "ok"
   },
   "1ec7bfe2da6914ffb73754b7fdaa0331": {
    "capture_id": "330443be369cff2a1bb936473afe45fc",
