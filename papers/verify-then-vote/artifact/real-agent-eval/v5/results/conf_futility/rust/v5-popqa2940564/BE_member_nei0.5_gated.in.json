    "raw_output_sha256": "d05321015b4e689ec419db8cb88c3c922e469250f893df823b1389412485ae59",
    "score_q": 80,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
