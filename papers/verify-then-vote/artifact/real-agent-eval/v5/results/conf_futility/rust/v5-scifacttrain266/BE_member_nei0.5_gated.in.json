    "raw_output_sha256": "2e9c427f1ae6648e7b54150ff1485516ff3d4ec73f33ce61027d62470086e06c",
    "score_q": 9200,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
      "k1_x1000": 1200,
