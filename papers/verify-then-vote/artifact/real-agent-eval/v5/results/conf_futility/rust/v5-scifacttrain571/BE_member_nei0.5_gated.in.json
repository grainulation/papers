    "spans": [
     {
      "end": 285,
      "start": 0,
      "text": "Epithelial and mesenchymal subpopulations within normal basal breast cell lines exhibit distinct stem cell/progenitor properties.\nBased on our findings, we propose that EMT in normal basal cells and claudin-low breast cancers reflects aberrant/incomplete myoepithelial differentiation."
     }
    ],
    "status": "ok"
