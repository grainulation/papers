    "raw_output_sha256": "ab57b7dbd914e8207e49ceff5150c4eba72a3791b0ca3a007188e3c1af8b4cab",
    "score_q": 7000,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
