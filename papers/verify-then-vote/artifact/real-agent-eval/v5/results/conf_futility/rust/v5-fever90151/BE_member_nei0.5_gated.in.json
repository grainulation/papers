    "label": "supports",
    "raw_output_sha256": "90c2ac389fe3b99319e3da9a57cd235ccfc64a0e817a7ba47f7ba5edaa8427d3",
    "score_q": 93,
    "span_selector": {
     "method": "bm25/1",
