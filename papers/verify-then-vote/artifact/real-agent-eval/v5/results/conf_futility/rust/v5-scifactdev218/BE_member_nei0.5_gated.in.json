    "spans": [
     {
      "end": 349,
      "start": 0,
      "text": "CX3CR1 is required for airway inflammation by promoting T helper cell survival and maintenance in inflamed lung\nCX3CR1-induced survival was also observed for T(H)1 cells upon airway inflammation but not under homeostatic conditions or upon peripheral inflammation. Therefore, CX3CR1 and CX3CL1 may represent attractive therapeutic targets in asthma."
     }
    ],
    "status": "ok"
   },
