    "raw_output_sha256": "81276ea374c20068f6bc12f1ab771749b49d9539aed558339a3d6565de47cb33",
    "score_q": 6000,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
