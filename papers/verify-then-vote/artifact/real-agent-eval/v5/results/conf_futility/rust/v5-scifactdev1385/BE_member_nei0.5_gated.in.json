    "raw_output_sha256": "ed35b9301d139f336ab892baeed6fb592a002f45ff56b6e88bcee5915b7e81bd",
    "score_q": 9000,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
      "k1_x1000": 1200,
