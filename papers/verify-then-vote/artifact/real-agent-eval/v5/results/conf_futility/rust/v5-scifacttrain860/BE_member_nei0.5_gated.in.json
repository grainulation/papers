    "raw_output_sha256": "2a3597ec44075a9ce0ad7c7555e4deae46ed8cca191f34a96d0e5d18fcfc8b4a",
    "score_q": 6500,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
