    "spans": [
     {
      "end": 442,
      "start": 0,
      "text": "Boe, Guinea-Bissau\nBoe ( full name Madina do Boe ) is a settlement in the southeastern region of Guinea-Bissau . In this location the independence of Guinea-Bissau was declared on September 24 , 1973 . Boe served as the Guinea-Bissau de facto capital until 1974 , when Portugal offered independence to Portuguese Guinea after the Carnation Revolution in Lisbon , and Bissau was declared the national capital of the newly independent country ."
     }
    ],
    "status": "ok"
   },
