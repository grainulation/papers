    "spans": [
     {
      "end": 306,
      "start": 0,
      "text": "Pdgfr\u03b2+ Mural Preadipocytes Contribute to Adipocyte Hyperplasia Induced by High-Fat-Diet Feeding and Prolonged Cold Exposure in Adult Mice.\nThese results provide genetic evidence for a mural cell origin of white adipocytes in obesity and suggest that beige adipogenesis may originate from multiple sources."
     }
    ],
    "status": "ok"
   },
