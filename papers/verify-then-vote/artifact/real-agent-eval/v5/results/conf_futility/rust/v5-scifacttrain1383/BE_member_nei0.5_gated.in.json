    "raw_output_sha256": "4d564326bec521f2395e310c83747127af3f07059564802f855cd0c8ff0331b2",
    "score_q": 93,
    "span_selector": {
     "method": "bm25/1",
     "params": {
      "b_x1000": 750,
      "chunk_chars": 1000,
      "k1_x1000": 1200,
