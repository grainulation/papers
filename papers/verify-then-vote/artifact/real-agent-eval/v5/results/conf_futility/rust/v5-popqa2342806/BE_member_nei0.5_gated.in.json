    "spans": [
     {
      "end": 382,
      "start": 0,
      "text": "Dervorguilla of Galloway\nDervorguilla of Galloway ( c. 1210 -- 28 January 1290 ) was a ` lady of substance ' in 13th century Scotland , the wife from 1223 of John , 5th Baron de Balliol , and mother of John I , a future king of Scotland . The name Dervorguilla or Devorgilla was a Latinization of the Gaelic Dearbhfhorghaill ( alternative spellings , Derborgaill or Dearbhorghil ) ."
     }
    ],
    "status": "ok"
   },
