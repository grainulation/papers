.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/
# LaTeX build outputs (each paper commits its paper.pdf at the paper root)
papers/*/tex/main.pdf
papers/*/tex/supplement.pdf
papers/*/tex/*.aux
papers/*/tex/*.log
papers/*/tex/*.bbl
papers/*/tex/*.blg
papers/*/tex/*.out
papers/*/tex/*.toc
papers/*/tex/arxiv.tar.gz
# Build products and regenerable caches in artifacts
papers/*/artifact/**/target/
papers/*/artifact/**/.lake/
papers/*/artifact/corpus-cache/**/*.npy
papers/*/artifact/**/evidence-cache/
papers/*/artifact/**/judge-store*/
papers/*/artifact/**/eval/rust/
papers/*/artifact/bench-output/
# reducer binary copied into the Python package by bindings/python/scripts/build_wheel.py
papers/*/artifact/bindings/python/src/overturn_arbiter/_bin/overturn

# Host-specific agent settings and local package build outputs
.claude/
.codex/
.pytest_cache/
papers/*/artifact/bindings/python/dist/
papers/*/artifact/bindings/python/src/overturn_arbiter/_bin/overturn.exe
